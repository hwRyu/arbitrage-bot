# =====================================================================
# 김프 헷지 봇 설정 예시 — 복사해서 .env 로 사용: cp .env.example .env
# 비워두거나 줄을 지우면 기본값(kimp/config.py)이 적용된다.
# 전략 기준: docs/concept.md
#   업비트·바이비트 모두 USDT 자본. 업비트는 USDT → 코인 → USDT 로 한 바퀴, 바이비트는 같은 금액 숏.
#   김프 = 업비트 USDT 가격 기준 '코인 몫' 김프 (테더 프리미엄·환율 제외), 손익 = USDT
# =====================================================================

# 실행 모드 (현재 버전은 true 만 지원)
PAPER_TRADING=true

# 모니터링할 코인 (쉼표 구분). 업비트 원화 마켓 + 바이비트 USDT 무기한 둘 다 있는 코인만
COINS=XRP,SOL,DOGE

# ---------------- 진입 / 청산 ----------------
# 진입 김프(코인 몫, 실제 체결가)가 이 값(%) 이하이면 진입. 주요 코인은 평소 0% 근처
# 김프 사이트 숫자와 다르다: 사이트 김프 ≈ 이 값 + 테더 프리미엄
ENTRY_PREMIUM_THRESHOLD_PERCENT=-0.5
# 모든 비용을 뺀 순이익률(%)이 이 값 이상이면 청산
TARGET_NET_PROFIT_PERCENT=1.0
# 순손익률(%)이 이 값 이하이면 손절 (음수, 0 = 사용 안 함)
STOP_LOSS_PERCENT=-5.0

# ---------------- 포지션 크기 ----------------
# 포지션 하나 크기 (바이비트 숏 금액, USDT). 비워두면 자동:
#   업비트 쪽 자본 × CAPITAL_USAGE_PERCENT ÷ MAX_OPEN_POSITIONS (자본이 늘면 같이 커짐)
POSITION_SIZE_USDT=
CAPITAL_USAGE_PERCENT=90
MAX_OPEN_POSITIONS=3
# 청산 후 같은 코인 재진입 대기 시간 (초)
REENTRY_COOLDOWN_SEC=300
# 맨 앞 호가 대비 평균 체결가가 이 값(%)보다 나쁘면 진입 안 함
MAX_SLIPPAGE_PERCENT=0.3

# ---------------- 바이비트 레버리지 / 자본 비율 / 리밸런싱 ----------------
# 레버리지(배). 자본 비율이 자동으로 정해진다: 업비트 = 레버리지 ÷ (레버리지 + 1 + 여유분)
#   1배 → 43.5 : 56.5 / 2배 → 60.6 : 39.4 / 3배 → 69.8 : 30.2  (여유분 30% 기준)
#   강제청산: 1배 가격 약 2배 / 2배 약 +49.5% / 3배 약 +32.8%
BYBIT_LEVERAGE=1
# 바이비트에 증거금 말고 더 둘 여유분 (증거금의 %)
BYBIT_MARGIN_BUFFER_PERCENT=30
# 바이비트 유지증거금률 (소수, 강제청산 가격 계산용)
BYBIT_MMR=0.005
# 강제청산까지 남은 상승폭이 이 % 아래면 '증거금 추가' 긴급 경고
LIQUIDATION_WARN_PERCENT=15
# 양쪽 자본 비율이 목표에서 이 %p 넘게 벗어나면 리밸런싱 알림 (시작할 때 / 청산 직후 확인)
REBALANCE_THRESHOLD_PERCENT=10

# ---------------- 코인별 덮어쓰기 (선택) ----------------
# 진입 기준 / 목표 / 손절 / 포지션 크기는 '공통값'. 특정 코인만 바꾸려면 '<코인>_<항목>'
# 시작 로그에 코인별 적용값이 나오고, 바꾼 값에는 * 가 붙는다. COINS 에 없는 코인 설정은 경고 후 무시
#XRP_ENTRY_PREMIUM_THRESHOLD_PERCENT=-0.3
#SOL_ENTRY_PREMIUM_THRESHOLD_PERCENT=-1.0
#SOL_TARGET_NET_PROFIT_PERCENT=1.5
#DOGE_POSITION_SIZE_USDT=300

# ---------------- 비용 (본인 계정 기준으로 확인 후 수정) ----------------
# 수수료율은 소수: 0.0005 = 0.05%
# 업비트: 코인 매매와 USDT/KRW 매매 둘 다 이 수수료 (한 바퀴에 4번)
UPBIT_TRADE_FEE_RATE=0.0005
BYBIT_TAKER_FEE_RATE=0.00055
# 사이클(진입~청산)마다 미리 떼어두는 전송비 (리밸런싱 송금 비용, USDT). 전송 안 하면 0
TRANSFER_FEE_USDT_PER_CYCLE=1.0
# 청산 예상 김프 '표시용' 여유분 (%) — 실제 판단에는 호가창 체결가 사용
SLIPPAGE_BUFFER_PERCENT=0.05

# ---------------- 주기 ----------------
SCAN_INTERVAL_SEC=3
SNAPSHOT_INTERVAL_SEC=60
FUNDING_REFRESH_SEC=60
ORDERBOOK_DEPTH=30

# ---------------- 달러 환율 (표시용: 사이트식 김프, 테더 프리미엄) ----------------
# 못 받아도 매매에는 영향 없음
FX_REFRESH_SEC=60
# 값을 넣으면 조회 없이 이 환율로 고정
FIXED_USD_KRW=

# ---------------- 페이퍼 시작 자본 (처음 실행할 때 1번, 목표 비율대로 자동 분배) ----------------
PAPER_INITIAL_TOTAL_USDT=10000

# ---------------- 시뮬레이션 (python -m kimp.simulate) ----------------
# 과거 캔들 / 환율 / 펀딩비 이력과 시뮬레이션 결과 DB (실시간 봇 DB 와 따로)
HISTORY_DB_PATH=data/history.db
# 과거엔 호가창이 없어서 코인 호가 간격(업비트 코인 + 바이비트, %)을 가정한다.
# 실시간 김프 기록 측정값 → 코인별 설정 → 아래 기본값 순서. 호가 한 칸보다는 좁게 잡지 않는다
SIM_DEFAULT_SPREAD_PERCENT=0.1
#DOGE_SIM_SPREAD_PERCENT=0.9

# ---------------- 저장소 / 로그 ----------------
DB_PATH=data/kimp.db
LOG_LEVEL=INFO
LOG_DIR=logs
