# =====================================================================
# 김프 헷지 봇 설정 예시 — 복사해서 .env 로 사용: cp .env.example .env
# 비워두거나 줄을 지우면 기본값(kimp/config.py)이 적용된다.
# 전략 기준: docs/concept.md
#   업비트·바이비트 모두 USDT 자본. 업비트는 USDT → 코인 → USDT 로 한 바퀴, 바이비트는 같은 금액 숏.
#   김프 = 업비트 USDT 가격 기준 '코인 몫' 김프 (테더 프리미엄·환율 제외), 손익 = USDT
# =====================================================================

# 실행 모드 (docs/live.md)
#   true  = 페이퍼 (가짜 잔고·주문)
#   false = 실거래 계열: LIVE_DRY_RUN=true 면 드라이런(실제 잔고로 시작, 주문 안 냄),
#           LIVE_DRY_RUN=false + LIVE_CONFIRM=YES 면 실제 주문
PAPER_TRADING=true

# ---------------- 실거래 (PAPER_TRADING=false 일 때, docs/live.md) ----------------
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
BYBIT_API_KEY=
BYBIT_API_SECRET=
LIVE_DRY_RUN=true
# 실제 주문을 내려면 정확히 YES
LIVE_CONFIRM=
# 안전 한도 (모든 모드 같은 로직. 비우면 페이퍼는 제한 없음, 실거래·드라이런은 50 / 10)
MAX_POSITION_USDT=
DAILY_LOSS_LIMIT_USDT=
MAX_CONSECUTIVE_FAILURES=3
# 이 파일이 있으면 신규 진입 중단 (touch data/STOP), 지우면 재개
STOP_FILE=data/STOP
# 거래소 실제 잔고·포지션과 DB 비교 간격 (초)
RECONCILE_INTERVAL_SEC=600
LIVE_DB_PATH=data/live.db
DRY_RUN_DB_PATH=data/dryrun.db

# 자동 송금 (기본 false = 알림만). 켜기 전에 출금 허용 주소 등록 + 소액 수동 송금으로 확인
AUTO_TRANSFER_ENABLED=false
# 보낼 네트워크: 같은 체인도 거래소마다 이름이 다름 (트론 = 업비트 TRX / 바이비트 TRC20). live_check 로 목록 확인
UPBIT_TRANSFER_NETWORK=TRX
BYBIT_TRANSFER_NETWORK=TRC20
TRANSFER_MIN_USDT=10
TRANSFER_MAX_USDT_PER_DAY=1000
TRANSFER_ALERT_MINUTES=60
# 받는 주소 (비우면 거래소에서 내 입금 주소 조회)
BYBIT_DEPOSIT_ADDRESS=
BYBIT_DEPOSIT_TAG=
UPBIT_DEPOSIT_ADDRESS=
UPBIT_DEPOSIT_TAG=

# 텔레그램 알림 (@BotFather 토큰, getUpdates 의 chat.id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 모니터링할 코인 (쉼표 구분). 업비트 원화 마켓 + 바이비트 USDT 무기한 둘 다 있는 코인만
COINS=XRP,SOL,DOGE

# ---------------- 진입 / 청산 ----------------
# 진입 김프(코인 몫, 실제 체결가)가 이 값(%) 이하이면 진입. 주요 코인은 평소 0% 근처
# 김프 사이트 숫자와 다르다: 사이트 김프 ≈ 이 값 + 테더 프리미엄
ENTRY_PREMIUM_THRESHOLD_PERCENT=-0.5
# 모든 비용을 뺀 순이익률(%)이 이 값 이상이면 청산
TARGET_NET_PROFIT_PERCENT=1.0
# 순손익률(%)이 이 값 이하이면 손절 (음수, 0 = 사용 안 함)
STOP_LOSS_PERCENT=-5.0

# ---------------- 포지션 크기 ----------------
# 포지션 하나 크기 (바이비트 숏 금액, USDT). 비워두면 자동:
#   업비트 쪽 자본 × CAPITAL_USAGE_PERCENT ÷ MAX_OPEN_POSITIONS (자본이 늘면 같이 커짐)
POSITION_SIZE_USDT=
CAPITAL_USAGE_PERCENT=90
MAX_OPEN_POSITIONS=3
# 청산 후 같은 코인 재진입 대기 시간 (초)
REENTRY_COOLDOWN_SEC=300
# 맨 앞 호가 대비 평균 체결가가 이 값(%)보다 나쁘면 진입 안 함
MAX_SLIPPAGE_PERCENT=0.3

# ---------------- 바이비트 레버리지 / 자본 비율 / 리밸런싱 ----------------
# 레버리지(배). 자본 비율이 자동으로 정해진다: 업비트 = 레버리지 ÷ (레버리지 + 1 + 여유분)
#   1배 → 43.5 : 56.5 / 2배 → 60.6 : 39.4 / 3배 → 69.8 : 30.2  (여유분 30% 기준)
#   강제청산: 1배 가격 약 2배 / 2배 약 +49.5% / 3배 약 +32.8%
BYBIT_LEVERAGE=1
# 바이비트에 증거금 말고 더 둘 여유분 (증거금의 %)
BYBIT_MARGIN_BUFFER_PERCENT=30
# 바이비트 유지증거금률 (소수, 강제청산 가격 계산용)
BYBIT_MMR=0.005
# 강제청산까지 남은 상승폭이 이 % 아래면 '증거금 추가' 긴급 경고
LIQUIDATION_WARN_PERCENT=15
# 양쪽 자본 비율이 목표에서 이 %p 넘게 벗어나면 리밸런싱 알림 (시작할 때 / 청산 직후 확인)
REBALANCE_THRESHOLD_PERCENT=10
# 진입 뒤 양쪽 금액(업비트 코인 값 vs 바이비트 숏) 차이가 이 % 보다 크면 큰 쪽을 줄여 맞춤 (부분 체결 대비)
HEDGE_TOLERANCE_PERCENT=1.0
# 업비트 최소 주문 금액 (원). 실거래·드라이런은 업비트에서 마켓별로 받아오고, 못 받으면 이 값
UPBIT_MIN_ORDER_KRW=5000
# 리밸런싱 송금 한 번의 출금 수수료 (USDT). 송금할 때만 든다 (거래마다 X)
# 보내는 거래소가 떼기 때문에 방향마다 다르다 (2026-10-22 확인, 트론 체인)
#   업비트 → 바이비트: 업비트 USDT(TRX) 출금 무료      → 0
#   바이비트 → 업비트: 바이비트 USDT(TRC20) 출금       → 1.3
# 거래소가 바꿀 수 있다. python -m kimp.live_check 로 가끔 확인할 것
TRANSFER_FEE_UPBIT_TO_BYBIT_USDT=0
TRANSFER_FEE_BYBIT_TO_UPBIT_USDT=1.3
# 페이퍼/시뮬레이션: 송금이 필요할 때(청산 후 10%p 넘게 깨짐 / 진입하려는데 한쪽이 모자람)
# 사용자가 보냈다고 치고 자동으로 옮긴다 (수수료 1번). false 면 알림만. 실거래·드라이런은 AUTO_TRANSFER_ENABLED
PAPER_AUTO_REBALANCE=true

# ---------------- 코인별 덮어쓰기 (선택) ----------------
# 진입 기준 / 목표 / 손절 / 포지션 크기는 '공통값'. 특정 코인만 바꾸려면 '<코인>_<항목>'
# 시작 로그에 코인별 적용값이 나오고, 바꾼 값에는 * 가 붙는다. COINS 에 없는 코인 설정은 경고 후 무시
#XRP_ENTRY_PREMIUM_THRESHOLD_PERCENT=-0.3
#SOL_ENTRY_PREMIUM_THRESHOLD_PERCENT=-1.0
#SOL_TARGET_NET_PROFIT_PERCENT=1.5
#DOGE_POSITION_SIZE_USDT=300

# ---------------- 비용 (본인 계정 기준으로 확인 후 수정) ----------------
# 수수료율은 소수: 0.0005 = 0.05%
# 업비트: 코인 매매와 USDT/KRW 매매 둘 다 이 수수료 (한 바퀴에 4번)
UPBIT_TRADE_FEE_RATE=0.0005
BYBIT_TAKER_FEE_RATE=0.00055
# (선택) 거래 한 번(진입~청산)마다 손익에서 미리 떼어둘 전송비 (USDT). 기본 0
#   송금은 거래마다 하는 게 아니라 '필요할 때만' 한다 → 그 비용은 위 TRANSFER_FEE_*_USDT
TRANSFER_FEE_USDT_PER_CYCLE=0
# 청산 예상 김프 '표시용' 여유분 (%) — 실제 판단에는 호가창 체결가 사용
SLIPPAGE_BUFFER_PERCENT=0.05

# ---------------- 주기 ----------------
SCAN_INTERVAL_SEC=3
SNAPSHOT_INTERVAL_SEC=60
FUNDING_REFRESH_SEC=60
ORDERBOOK_DEPTH=30

# ---------------- 달러 환율 (표시용: 사이트식 김프, 테더 프리미엄) ----------------
# 못 받아도 매매에는 영향 없음
FX_REFRESH_SEC=60
# 값을 넣으면 조회 없이 이 환율로 고정
FIXED_USD_KRW=

# ---------------- 페이퍼 시작 자본 (처음 실행할 때 1번, 목표 비율대로 자동 분배) ----------------
PAPER_INITIAL_TOTAL_USDT=10000

# ---------------- 시뮬레이션 (python3 -m kimp.simulate) ----------------
# 과거 캔들 / 환율 / 펀딩비 이력과 시뮬레이션 결과 DB (실시간 봇 DB 와 따로)
HISTORY_DB_PATH=data/history.db
# 과거엔 호가창이 없어서 코인 호가 간격(업비트 코인 + 바이비트, %)을 가정한다.
# 실시간 김프 기록 측정값 → 코인별 설정 → 아래 기본값 순서. 호가 한 칸보다는 좁게 잡지 않는다
SIM_DEFAULT_SPREAD_PERCENT=0.1
#DOGE_SIM_SPREAD_PERCENT=0.9

# ---------------- 펀딩비 수익 전략 (docs/carry.md) ----------------
# 바이비트 현물 매수 + 같은 개수 숏 → 가격 변동 상쇄, 펀딩비(+)를 숏이 받음. 김프 전략과 자본·잔고 따로
CARRY_ENABLED=true
# 비워두면 자동 선택 (현물+무기한 있고, 거래대금 충분하고, 펀딩비 높은 순)
CARRY_COINS=
CARRY_CAPITAL_USDT=1000
# 1배 → 포지션 N 마다 현물 N + 증거금 N (강제청산 약 2배). 2배 → 현물 N + 증거금 N/2 (약 +49.5%)
CARRY_LEVERAGE=1
CARRY_MAX_POSITIONS=3
# 비우면 자동 = 자본 × 90% ÷ 최대 개수 ÷ (1 + 1/레버리지) → 1배 기본 150 USDT
CARRY_POSITION_SIZE_USDT=
# 진입: 72시간·24시간 하루 평균 펀딩이 둘 다 이 % 이상 + 지금 비율 +
CARRY_ENTRY_MIN_DAILY_PERCENT=0.03
CARRY_ENTRY_LOOKBACK_HOURS=72
# 청산: 24시간 하루 평균이 이 % 아래
CARRY_EXIT_BELOW_DAILY_PERCENT=0
CARRY_EXIT_LOOKBACK_HOURS=24
# 선물 매수1호가 ÷ 현물 매도1호가 − 1 이 이 % 보다 낮으면 진입 안 함
CARRY_MIN_ENTRY_BASIS_PERCENT=-0.1
# 강제청산까지 남은 상승폭이 이 % 보다 작으면 양쪽 미리 정리 (0 = 끔, 경고만)
CARRY_LIQ_GUARD_PERCENT=15
CARRY_REENTRY_COOLDOWN_HOURS=24
CARRY_SPOT_FEE_RATE=0.001
CARRY_MIN_VOLUME_USDT=5000000
CARRY_UNIVERSE_MAX=40
CARRY_SCAN_INTERVAL_SEC=60
CARRY_REFRESH_SEC=600

# ---------------- 저장소 / 로그 ----------------
DB_PATH=data/kimp.db
LOG_LEVEL=INFO
LOG_DIR=logs
