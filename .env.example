# =====================================================================
# 김프 헷지 봇 설정 예시 — 복사해서 .env 로 사용: cp .env.example .env
# 비워두거나 줄을 지우면 기본값(kimp/config.py)이 적용된다.
# 전략 기준: docs/concept.md
#   업비트·바이비트 모두 USDT 자본. 업비트는 USDT → 코인 → USDT 로 한 바퀴, 바이비트는 같은 금액 숏.
#   김프 = 업비트 USDT 가격 기준 '코인 몫' 김프 (테더 프리미엄·환율 제외), 손익 = USDT
# =====================================================================

# 실행 모드 (docs/live.md)
#   true  = 페이퍼 (가짜 잔고·주문)
#   false = 실거래 계열: LIVE_DRY_RUN=true 면 드라이런(실제 잔고로 시작, 주문 안 냄),
#           LIVE_DRY_RUN=false + LIVE_CONFIRM=YES 면 실제 주문
PAPER_TRADING=true

# ---------------- 실거래 (PAPER_TRADING=false 일 때, docs/live.md) ----------------
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
BYBIT_API_KEY=
BYBIT_API_SECRET=
LIVE_DRY_RUN=true
# 실제 주문을 내려면 정확히 YES
LIVE_CONFIRM=
# 안전 한도 (모든 모드 같은 로직. 비우면 페이퍼는 제한 없음, 실거래·드라이런은 50 / 10)
MAX_POSITION_USDT=
DAILY_LOSS_LIMIT_USDT=
MAX_CONSECUTIVE_FAILURES=3
# 이 파일이 있으면 신규 진입 중단 (touch data/STOP), 지우면 재개
STOP_FILE=data/STOP
# 거래소 실제 잔고·포지션과 DB 비교 간격 (초)
RECONCILE_INTERVAL_SEC=600
LIVE_DB_PATH=data/live.db
DRY_RUN_DB_PATH=data/dryrun.db

# 자동 송금 (기본 false = 알림만). 켜기 전에 출금 허용 주소 등록 + 소액 수동 송금으로 확인
AUTO_TRANSFER_ENABLED=false
# 보낼 네트워크: 같은 체인도 거래소마다 이름이 다름 (트론 = 업비트 TRX / 바이비트 TRC20). live_check 로 목록 확인
UPBIT_TRANSFER_NETWORK=TRX
BYBIT_TRANSFER_NETWORK=TRC20
# 한 번에 보낼 최소 금액 (USDT). 이 값보다 **커야** 보낸다 (작으면 아예 안 보냄).
#   왜 있나: 수수료만 나가는 자투리 송금을 막는다. 바이비트→업비트는 1.3 USDT 가 수수료라
#   5 USDT 를 보내면 수수료가 26퍼센트다. 업비트→바이비트는 무료라서 이 값이 유일한 문턱이다.
#   소액 테스트를 하려면 이 값을 보낼 양보다 작게 내려야 한다 (예: 1 USDT 테스트 -> 0.5)
TRANSFER_MIN_USDT=10
# 하루에 보낼 수 있는 합계 (USDT, 한국 시간 0시 기준). 보낼 양이 이 한도로 **깎인다**.
#   왜 있나: 계산이 틀렸거나 봇이 이상해져도 하루에 움직일 수 있는 돈의 상한을 둔다.
#   소액 테스트에 쓰기 좋다 - 1 로 두면 정확히 1 USDT 만 나가고, 그날은 더 안 나간다
#   (오늘 보낸 합계가 한도에 닿으면 보낼 양이 0 이 되어 저절로 멈춘다)
TRANSFER_MAX_USDT_PER_DAY=1000
TRANSFER_ALERT_MINUTES=60
# 받는 주소 (비우면 거래소에서 내 입금 주소 조회)
BYBIT_DEPOSIT_ADDRESS=
BYBIT_DEPOSIT_TAG=
UPBIT_DEPOSIT_ADDRESS=
UPBIT_DEPOSIT_TAG=

# 텔레그램 알림 (@BotFather 토큰, getUpdates 의 chat.id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 모니터링할 코인 (쉼표 구분). 업비트 원화 마켓 + 바이비트 USDT 무기한 둘 다 있는 코인만
COINS=XRP,SOL,DOGE

# ---------------- 진입 / 청산 ----------------
# 진입 김프(코인 몫, 실제 체결가)가 이 값(%) 이하이면 진입. 주요 코인은 평소 0% 근처
# 김프 사이트 숫자와 다르다: 사이트 김프 ≈ 이 값 + 테더 프리미엄
ENTRY_PREMIUM_THRESHOLD_PERCENT=-0.5
# 모든 비용을 뺀 순이익률(%)이 이 값 이상이면 청산
TARGET_NET_PROFIT_PERCENT=1.0
# 순손익률(%)이 이 값 이하이면 손절 (음수, 0 = 사용 안 함)
STOP_LOSS_PERCENT=-5.0

# ---------------- 코인별 덮어쓰기 (선택) ----------------
# 진입 기준 / 목표 / 손절 / 포지션 크기는 '공통값'. 특정 코인만 바꾸려면 '<코인>_<항목>'
# 시작 로그에 코인별 적용값이 나오고, 바꾼 값에는 * 가 붙는다. COINS 에 없는 코인 설정은 경고 후 무시
#XRP_ENTRY_PREMIUM_THRESHOLD_PERCENT=-0.3
#SOL_ENTRY_PREMIUM_THRESHOLD_PERCENT=-1.0
#SOL_TARGET_NET_PROFIT_PERCENT=1.5
#DOGE_POSITION_SIZE_USDT=300
# 수수료도 코인별로: <코인>_UPBIT_TRADE_FEE_RATE / <코인>_BYBIT_TAKER_FEE_RATE (소수). 없으면 바이비트는 거래소 조회값, 업비트는 공통값.
#    COINS 에 없는 코인도 받는다 (추천·시뮬이 그 코인을 평가할 때 쓴다). 예) CAP_BYBIT_TAKER_FEE_RATE=0.0011
#CAP_BYBIT_TAKER_FEE_RATE=0.0011

# ---------------- 포지션 크기 ----------------
# 포지션 하나 크기 (바이비트 숏 금액, USDT). 비워두면 자동:
#   업비트 쪽 자본 × CAPITAL_USAGE_PERCENT ÷ MAX_OPEN_POSITIONS (자본이 늘면 같이 커짐)
POSITION_SIZE_USDT=
CAPITAL_USAGE_PERCENT=90
MAX_OPEN_POSITIONS=3
# 청산 후 같은 코인 재진입 대기 시간 (초). 2026-10-31 300 → 60 (사용자 결정): 깜빡이는 신호에 재진입하는 것은 신호 필터가 막으므로, 긴 대기는 다시 벌어진 진짜 김프를 놓치는 비용만 남는다. 청산 주문 정리·잔고 반영 시간만큼만 둔다
REENTRY_COOLDOWN_SEC=60
# ★ 연속 놓침 쉬기: 같은 코인의 지정가 FOK 진입 놓침이 WINDOW 초 안에 LIMIT 번이면 그 코인은 COOLDOWN 초 동안 진입 안 함
#    (LIMIT 0 = 끔). docs/issues.md 놓침 후보 N1.
#    ※ 지금은 거의 의미 없는 옵션 (2026-10-31): 원래 놓침 한 번에 USDT 왕복 약 0.1~0.2% 가 들어 반복 놓침을 끊으려던 것인데,
#    10-30 부터 코인 FOK 를 먼저 내서 놓침 비용이 0 이 됐고, 놓침의 원인이던 1초 미만 신호는 신호 게이트가 앞단에서 거른다.
#    남는 효과는 "두 번 놓치면 10분간 그 코인 기회를 포기" 뿐이라 사실상 보험으로만 둔다 (사용자 결정: 일단 유지)
ENTRY_MISS_STREAK_LIMIT=2
ENTRY_MISS_WINDOW_SEC=300
ENTRY_MISS_COOLDOWN_SEC=600
# 시장가 다리(업비트 USDT·바이비트)의 평균 체결가가 맨 앞 호가보다 이 값(%) 넘게 밀리면 진입 안 함 (업비트 코인은 지정가 FOK 라 해당 없음)
MAX_SLIPPAGE_PERCENT=0.3
# 업비트 코인 주문은 설정 없이 정해져 있다 (2026-10-29 시장가 모드 제거):
#   진입 매수·익절 매도 = 판단한 가격에 지정가 FOK (전량 즉시 체결 아니면 취소). 판단보다 나쁘게는 안 잡힌다.
#     진입 놓침 = 판 USDT 되삼 (약 0.1~0.2%), 익절 놓침 = 포지션 그대로 2초 뒤 다시
#   손절·강제청산 가드·수동 청산·되돌리기 = 시장가 (빠져나오는 게 우선). USDT 사고팔기·바이비트는 늘 시장가

# ---------------- 바이비트 레버리지 / 자본 비율 / 리밸런싱 ----------------
# 레버리지(배). 자본 비율이 자동으로 정해진다: 업비트 = 레버리지 ÷ (레버리지 + 1 + 여유분)
#   여유분(BYBIT_MARGIN_BUFFER_PERCENT)은 수수료·펀딩비·추가 포지션용이다.
#   격리 마진이라 계좌에 남은 USDT 가 그 포지션의 증거금이 되지는 않는다 (강제청산 방지 아님).
#   1배 → 43.5 : 56.5 / 2배 → 60.6 : 39.4 / 3배 → 69.8 : 30.2  (여유분 30% 기준)
#   강제청산: 1배 가격 약 2배 / 2배 약 +49.5% / 3배 약 +32.8%
BYBIT_LEVERAGE=1
# 바이비트에 증거금 말고 더 둘 여유분 (증거금의 %)
BYBIT_MARGIN_BUFFER_PERCENT=30
# 바이비트 유지증거금률 (소수, 강제청산 가격 계산용)
BYBIT_MMR=0.005
# 강제청산까지 남은 상승폭이 이 % 아래면 '증거금 추가' 긴급 경고
LIQ_WARN_PERCENT=15
# ---- ★ 강제청산 가드: 청산 직전에 봇이 '증거금 추가' 또는 '미리 정리' 를 스스로 고른다 ----
# 발동 지점: 거래소 강제청산가까지 남은 상승폭이 이 % 안으로 오면 (10 = 청산가의 90% 지점에서 판단)
LIQ_GUARD_PERCENT=10
# 증거금 추가 조건 ①: 수익 목표까지 남은 거리가 이 %p 이내면 (곧 익절이니) 증거금을 넣고 들고 간다
LIQ_GUARD_NEAR_TARGET_PERCENT=0.5
# 증거금 추가 조건 ②: 순손익이 이 % 이하(역프가 깊음)면 지금 정리하면 손실 확정이라 증거금을 넣고 돌아올 때까지 기다린다
#    두 조건 다 아니면 → 지금 시세에 정리 (청산 사유 LIQ_GUARD)
LIQ_GUARD_HOLD_BELOW_PERCENT=-2
# 포지션당 증거금 추가 최대 횟수 (0 = 추가 없이 정리만)
LIQ_GUARD_TOPUP_MAX_ROUNDS=2
# 한 번에 넣는 양 = 그 포지션 원래 증거금 × 이 배수 (1 = 증거금만큼, 0.5 = 절반). 1배 기준 1회 투입 후 청산가: 1 → 3배, 0.5 → 2.5배
#    모든 포지션이 넣은 합은 자본 나눌 때 바이비트에 더 둔 여유분(BYBIT_MARGIN_BUFFER_PERCENT, 1배 30% 면 자본의 13%)
#    을 넘지 못한다 → 다음 진입 돈은 절대 안 건드린다. 여유분이 모자라면 남은 만큼만 넣고, 그것도 없으면 정리
LIQ_GUARD_TOPUP_UNIT_RATIO=1
# 양쪽 자본 비율이 목표에서 이 %p 넘게 벗어나면 리밸런싱 알림 (시작할 때 / 청산 직후 확인)
REBALANCE_THRESHOLD_PERCENT=10
# 진입 뒤 양쪽 금액(업비트 코인 값 vs 바이비트 숏) 차이가 이 % 보다 크면 큰 쪽을 줄여 맞춤 (부분 체결 대비).
#    바이비트 주문 단위 절반 이하 차이(숏은 가장 가까운 단위로 연다)와 업비트 최소 주문 미만 되팔기는 고칠 수 없어 기록만 (2026-10-31)
HEDGE_TOLERANCE_PERCENT=1.0
# ★ 신호 신뢰도 게이트 (2026-10-31, docs/filter.md): 기준·목표를 막 넘은 신호는 바로 믿지 않고, 되돌림 없이 유지돼
#    점수가 컷을 넘을 때만 주문. 깔끔하면 약 1.1×TAU 초 뒤, 흔들리면 더 늦게, 반납하면 안 함. false 면 켜지는 순간 주문
SIGNAL_FILTER_ENABLED=true
SIGNAL_FILTER_TAU_SEC=2.5
SIGNAL_FILTER_CUT=0.7
SIGNAL_FILTER_Z_SPIKE=3
# ★ 원화 버퍼: 업비트에 '가장 큰 포지션 크기 × 이 수' 만큼을 늘 원화로 둔다 (2026-10-30). 진입은 그 원화로 코인 FOK 를
#    먼저 내고 체결되면 쓴 만큼 USDT 를 되판다 → 놓쳐도 비용 0, 주문 0.4초 단축. 버퍼엔 USDT/KRW 시세 변동만 걸린다.
#    0 = 자동으로 채우지 않음
UPBIT_KRW_BUFFER_POSITIONS=2
# 업비트 최소 주문 금액 (원). 실거래·드라이런은 업비트에서 마켓별로 받아오고, 못 받으면 이 값
UPBIT_MIN_ORDER_KRW=5000
# ★ 펀딩비 안전장치
# 우리는 바이비트 숏이라 펀딩비율이 +면 받고 −면 낸다. 김프 회복을 며칠 기다리는 전략이라
# 내는 쪽에 오래 머물면 김프가 그대로여도 손실만 쌓인다.
#   예) 100 USDT 포지션, -0.0646%/8h → 하루 -0.194 USDT → 5일이면 목표(1%)를 전부 먹는다
# ① 진입 차단: 8시간 기준 펀딩비율이 이 값보다 나쁘면 진입하지 않는다 (비우면 끔)
ENTRY_MIN_FUNDING_8H_PERCENT=-0.05
# ★ 호가 간격 안전장치: 진입 직전 '지금 왕복 호가'(진입 김프 − 청산 김프, 맨 앞 호가 기준)가 이 %를 넘으면
#    들어가지 않는다 (0 = 보지 않음). 코인 가격이 호가 단위 경계(10·100·1,000원)를 넘으면 한 칸이 10배
#    넓어진다 — IRYS 가 100원을 넘자 한 칸이 1원(≈1%)이 되어 0.2% 목표가 구조적으로 안 나왔다
ENTRY_MAX_SPREAD_PERCENT=0.8
# ★ 업비트 호가 단위 경계 근처 진입 금지 (%): 매도 호가가 한 칸이 커지는 경계(100·1,000·10,000원 …) 아래 이 % 안이거나
#    딱 경계면 들어가지 않는다 (0 = 안 봄). 경계 바로 아래는 지금 호가 간격이 좁아 스프레드 가드를 통과하지만, 그 줄이 팔리면
#    다음 줄이 큰 칸(100원이면 1%) 위라 놓치기 쉽고 들고 있다 경계를 넘으면 익절이 어려워진다 (docs/issues.md #4)
#    예) 1 → 99.0~100원, 990~1,000원 은 진입 안 함
ENTRY_TICK_BOUNDARY_MARGIN_PERCENT=1
# ★ 업비트 지정가 FOK 진입 크기 상한 (%): '지정가 안쪽 물량'(전부 그 가격에 사도 진입 기준을 넘는 가장 비싼 매도 호가
#    줄까지의 물량 합) 중 이 %까지만 산다. 넘으면 숏 개수를 줄인다. 남이 먼저 일부를 사 가도 전량 체결될 여유
#    (docs/issues.md #3 B). 100 = 안쪽 물량만 안 넘게. 낮을수록 놓침은 줄고 포지션은 작아진다
ENTRY_MAX_DEPTH_SHARE_PERCENT=50
# ② 누적 한도: 펀딩비로 낸 금액이 포지션 금액의 이 %를 넘으면 정리한다 (0 = 무제한)
#    펀딩비를 낸 만큼 '필요한 청산 김프' 가 1:1 로 올라가서, 0.3%만 쌓여도 김프 범위가 좁은
#    코인(CAP·LIT 등)은 목표 도달이 사실상 불가능해진다 → 그 지점에서 끊는다
MAX_FUNDING_COST_PERCENT=0.3
# ★ 경계 위 모드 (2026-10-31, docs/issues.md #6): 호가 한 칸 % ≥ 목표 % 인 구간(100~500원대)은 목표 익절이 사실상 불가능하다.
#    예방: 위쪽 경계까지 거리 < 보통 하루 변동폭(최근 N일 일봉 고저 폭 중앙값)이면 진입 안 함.
#    보유 중 넘으면: 펀딩비 받는 중 → 순손익 ≥ 0 에 청산 / 내는 중 → 순손익(수수료 제외) ≥ −다음 정산 펀딩비 에 청산 (사유 TICK_ZONE_EXIT)
TICK_ZONE_ENABLED=true
TICK_ZONE_RANGE_DAYS=7

# ★ 한 번만 돌리기 (첫 실거래 점검용)
# true 면 포지션을 딱 하나만 잡고, 그 포지션이 청산되면 봇이 스스로 종료한다.
#   진입 → 보유 → 청산 → 점검 요약 출력 → 종료
# 이미 열린 포지션이 있으면 그것만 끝까지 관리하고 끝낸다 (새로 잡지 않음).
ONE_SHOT=false
# 위가 true 일 때, 이 시간을 넘겨도 목표/손절에 닿지 않으면 시장가로 정리하고 끝낸다 (0 = 무제한)
# 예) 6 → 6시간 뒤에도 조건에 안 닿으면 지금 시세로 청산 (청산 사유 TIMEOUT)
ONE_SHOT_MAX_HOURS=0

# 리밸런싱 송금 한 번의 출금 수수료 (USDT). 송금할 때만 든다 (거래마다 X)
# 보내는 거래소가 떼기 때문에 방향마다 다르다 (2026-10-22 확인, 트론 체인)
#   업비트 → 바이비트: 업비트 USDT(TRX) 출금 무료      → 0
#   바이비트 → 업비트: 바이비트 USDT(TRC20) 출금       → 1.3
# 거래소가 바꿀 수 있다. python -m kimp.live_check 로 가끔 확인할 것
TRANSFER_FEE_UPBIT_TO_BYBIT_USDT=0
TRANSFER_FEE_BYBIT_TO_UPBIT_USDT=1.3
# 페이퍼/시뮬레이션: 송금이 필요할 때(청산 후 10%p 넘게 깨짐 / 진입하려는데 한쪽이 모자람)
# 사용자가 보냈다고 치고 자동으로 옮긴다 (수수료 1번). false 면 알림만. 실거래·드라이런은 AUTO_TRANSFER_ENABLED
PAPER_AUTO_REBALANCE=true

# ---------------- 비용 (본인 계정 기준으로 확인 후 수정) ----------------
# 수수료율은 소수: 0.0005 = 0.05%
# 업비트: 코인 매매와 USDT/KRW 매매 둘 다 이 수수료 (한 바퀴에 4번)
UPBIT_TRADE_FEE_RATE=0.0005
# 바이비트 선물 시장가 수수료 기본값 (0.055%). 코인마다 다르다 — 일부 소형 코인은 0.11%. 봇·추천·시뮬이 시작할 때 코인별 요율을
#    거래소에서 받아 쓰고(API 키 필요), 이 값은 조회가 안 된 코인에만 쓴다 (kimp/fees.py). 코인별로 못 박으려면 '코인별 덮어쓰기'
BYBIT_TAKER_FEE_RATE=0.00055
# (선택) 거래 한 번(진입~청산)마다 손익에서 미리 떼어둘 전송비 (USDT). 기본 0
#   송금은 거래마다 하는 게 아니라 '필요할 때만' 한다 → 그 비용은 위 TRANSFER_FEE_*_USDT
TRANSFER_FEE_USDT_PER_CYCLE=0
# 체결 밀림 가정 (%) — 추천·시뮬·차트 관리선·'필요 김프' 표시가 거래당 비용으로 쓰는 값 (청산 때 판단 호가보다 불리하게
#    체결되는 몫). 실거래 익절은 이 값을 쓰지 않는다 (업비트 코인 매도가 판단가 지정가 FOK 라 판단보다 나쁘게 안 팔림).
#    세 도구는 --exec-slippage 숫자|auto 로 실행마다 덮어쓸 수 있다 (auto = 실거래 체결 기록의 코인별 중앙값)
SLIPPAGE_BUFFER_PERCENT=0.05

# ---------------- 주기 ----------------
# 한 바퀴(시세 조회 -> 대조 -> 청산 -> 리밸런싱 -> 진입) 주기 (초).
#   짧게 하면 짧게 생긴 기회를 잡지만 거래소 요청 제한에 가까워진다. 한 바퀴에 업비트를
#   코인 수 + 1 번 부르므로, 코인 4개 + 3초면 하루 28,800 바퀴다 (업비트 호가는 초당 10회 제한).
#   대조·잔고 조회가 겹치는 순간 429(요청 초과)가 난다 -> 코인이 많거나 목표가 높으면 10~20 초를 쓸 것.
#   QUOTE_SOURCE=ws 면: 판단은 호가가 바뀔 때마다(최소 0.25초 간격) 하고, 이 값은 잔고·포지션 REST 재조회 주기가 된다
SCAN_INTERVAL_SEC=10
SNAPSHOT_INTERVAL_SEC=60
FUNDING_REFRESH_SEC=60
ORDERBOOK_DEPTH=30
# ★ 시세를 어떻게 받나: rest = 스캔마다 요청 (기본, 한 번에 ~190 ms) / ws = 웹소켓으로 밀어 받음 (70~80 ms 뒤 도착).
#    ws 면 판단 순간 손에 최신 판이 있고, SCAN_INTERVAL_SEC 를 줄이면 기회를 1초 아래로 본다. 소켓이 끊기거나 그 거래소에서
#    QUOTE_WS_MAX_AGE_MS 동안 아무것도 안 오면 그 코인들은 그 스캔만 REST 로 받는다 (소켓이 죽어도 봇은 선다). 주문은 늘 REST.
#    업비트 소켓은 호가 15줄(REST 30줄)이라 포지션이 아주 크면 rest 가 낫다
QUOTE_SOURCE=rest
# ★ REST 요청 타임아웃 (ms). 거래소가 응답을 안 줄 때 스캔 안의 호출이 각각 이만큼 기다리므로 짧을수록 봇이 덜 멈춘다 (ccxt 기본 10000)
REST_TIMEOUT_MS=5000
# ★ 계좌 스냅샷 나이 한도 (초). 실거래는 잔고·숏을 별도 스레드가 받아 두고 판단은 그 값을 쓴다. 이보다 오래되면 신규 진입·숏 사라짐 판정 보류
ACCOUNT_STALE_SEC=10
QUOTE_WS_MAX_AGE_MS=5000

# ---------------- 달러 환율 (표시용: 사이트식 김프, 테더 프리미엄) ----------------
# 못 받아도 매매에는 영향 없음
FX_REFRESH_SEC=60
# 값을 넣으면 조회 없이 이 환율로 고정
FIXED_USD_KRW=

# ---------------- 페이퍼 시작 자본 (처음 실행할 때 1번, 목표 비율대로 자동 분배) ----------------
PAPER_INITIAL_TOTAL_USDT=10000

# ---------------- 시뮬레이션 (python3 -m kimp.simulate) ----------------
# 과거 캔들 / 환율 / 펀딩비 이력과 시뮬레이션 결과 DB (실시간 봇 DB 와 따로)
HISTORY_DB_PATH=data/history.db
# 시세 수집기(python -m kimp.collect)가 김프·호가 기록을 쌓는 DB (매매 기록과 따로)
SNAPSHOT_DB_PATH=data/market.db
# 과거엔 호가창이 없어서 코인 호가 간격(업비트 코인 + 바이비트, %)을 가정한다.
# 실시간 김프 기록 측정값 → 코인별 설정 → 아래 기본값 순서. 호가 한 칸보다는 좁게 잡지 않는다
SIM_DEFAULT_SPREAD_PERCENT=0.1
#DOGE_SIM_SPREAD_PERCENT=0.9

# ---------------- 펀딩비 수익 전략 (docs/carry.md) ----------------
# 바이비트 현물 매수 + 같은 개수 숏 → 가격 변동 상쇄, 펀딩비(+)를 숏이 받음
# 펀딩비 전략을 같이 돌릴지. **김프 전략과 완전히 별개로 주문을 낸다** (자본·잔고도 따로).
#   기본 false 인 이유: 실거래 검증 중에 다른 전략이 끼면 무엇 때문에 생긴 손익인지 알 수 없고,
#   ONE_SHOT(한 번만 돌리기)은 김프 포지션만 세므로 이 전략은 ONE_SHOT 제약을 받지 않는다.
CARRY_ENABLED=false
# 비워두면 자동 선택 (현물+무기한 있고, 거래대금 충분하고, 펀딩비 높은 순)
CARRY_COINS=
CARRY_CAPITAL_USDT=1000
# 1배 → 포지션 N 마다 현물 N + 증거금 N (강제청산 약 2배). 2배 → 현물 N + 증거금 N/2 (약 +49.5%)
CARRY_LEVERAGE=1
CARRY_MAX_POSITIONS=3
# 비우면 자동 = 자본 × 90% ÷ 최대 개수 ÷ (1 + 1/레버리지) → 1배 기본 150 USDT
CARRY_POSITION_SIZE_USDT=
# 진입: 72시간·24시간 하루 평균 펀딩이 둘 다 이 % 이상 + 지금 비율 +
CARRY_ENTRY_MIN_DAILY_PERCENT=0.03
CARRY_ENTRY_LOOKBACK_HOURS=72
# 청산: 24시간 하루 평균이 이 % 아래
CARRY_EXIT_BELOW_DAILY_PERCENT=0
CARRY_EXIT_LOOKBACK_HOURS=24
# 선물 매수1호가 ÷ 현물 매도1호가 − 1 이 이 % 보다 낮으면 진입 안 함
CARRY_MIN_ENTRY_BASIS_PERCENT=-0.1
# 강제청산까지 남은 상승폭이 이 % 보다 작으면 양쪽 미리 정리 (0 = 끔, 경고만)
CARRY_LIQ_GUARD_PERCENT=15
CARRY_REENTRY_COOLDOWN_HOURS=24
CARRY_SPOT_FEE_RATE=0.001
CARRY_MIN_VOLUME_USDT=5000000
CARRY_UNIVERSE_MAX=40
CARRY_SCAN_INTERVAL_SEC=60
CARRY_REFRESH_SEC=600

# ---------------- 저장소 / 로그 ----------------
DB_PATH=data/kimp.db
LOG_LEVEL=INFO
LOG_DIR=logs
