# =====================================================================
# 김프 헷지 봇 설정 예시 — 복사해서 .env 로 사용: cp .env.example .env
# 비워두거나 줄을 지우면 기본값(kimp/config.py)이 적용된다.
# =====================================================================

# 실행 모드 (현재 버전은 true 만 지원)
PAPER_TRADING=true

# 모니터링할 코인 (쉼표 구분). 업비트 KRW + 바이비트 USDT 무기한 둘 다 상장된 코인만 유효
COINS=XRP,SOL,DOGE

# ---------------- 진입 / 청산 ----------------
# 김프는 달러 환율 기준(테더 프리미엄 포함) = 김프 사이트와 같은 숫자로 생각하면 된다
# 실제로 체결될 가격으로 계산한 진입 김프가 이 값(%) 이하이면 진입. -0.5 = 역프 0.5% 이상
ENTRY_PREMIUM_THRESHOLD_PERCENT=0.0
# 모든 비용을 뺀 순이익률(%)이 이 값 이상이면 청산
TARGET_NET_PROFIT_PERCENT=1.0
# 순손익률(%)이 이 값 이하이면 손절 (음수, 0 = 사용 안 함)
STOP_LOSS_PERCENT=-5.0

# ---------------- 포지션 ----------------
# 코인당 포지션 규모 (바이비트 숏 명목가, USDT). 업비트에는 같은 금액(USDT 환산)만큼 매수
POSITION_SIZE_USDT=500
MAX_OPEN_POSITIONS=3
# 청산 후 같은 코인 재진입 대기 시간 (초)
REENTRY_COOLDOWN_SEC=300
# 최우선 호가 대비 평균 체결가가 이 값(%)보다 나쁘면 진입 안 함
MAX_SLIPPAGE_PERCENT=0.3

# ---------------- 코인별 덮어쓰기 (선택) ----------------
# 위의 진입 기준 / 목표 순이익 / 손절 / 포지션 규모는 '공통값'이다.
# 특정 코인만 다르게 하려면 '<코인>_<항목>' 으로 넣는다. 없는 항목은 공통값을 쓴다.
# 시작 로그에 코인별 적용값이 출력되며, 덮어쓴 값에는 * 가 붙는다.
# COINS 에 없는 코인의 설정은 무시되고 경고가 출력된다.
#XRP_ENTRY_PREMIUM_THRESHOLD_PERCENT=-0.3
#SOL_ENTRY_PREMIUM_THRESHOLD_PERCENT=-1.0
#SOL_TARGET_NET_PROFIT_PERCENT=1.5
#SOL_STOP_LOSS_PERCENT=-4.0
#DOGE_POSITION_SIZE_USDT=300

# ---------------- 비용 (본인 계정 기준으로 확인 후 수정) ----------------
# 수수료율은 소수: 0.0005 = 0.05%
UPBIT_TRADE_FEE_RATE=0.0005
BYBIT_TAKER_FEE_RATE=0.00055
# 사이클(진입~청산)당 배정할 USDT 전송 비용. 전송을 안 하면 0
TRANSFER_FEE_USDT_PER_CYCLE=1.0
# 청산 예상 김프 '표시용' 슬리피지 여유분 (%) — 실제 판단에는 호가창 체결가 사용
SLIPPAGE_BUFFER_PERCENT=0.05

# ---------------- 달러 환율 (김프 계산 기준) ----------------
# 몇 초마다 새로 받아올지 (yfinance)
FX_REFRESH_SEC=60
# 이 시간(초) 넘게 갱신이 안 되면 새 진입을 멈춘다 (보유 포지션 관리는 계속)
FX_MAX_STALE_SEC=1800
# 값을 넣으면 조회 없이 이 환율로 고정 (테스트용). 비워두면 실시간
FIXED_USD_KRW=

# ---------------- 주기 ----------------
SCAN_INTERVAL_SEC=3
SNAPSHOT_INTERVAL_SEC=60
FUNDING_REFRESH_SEC=60
ORDERBOOK_DEPTH=30

# ---------------- 페이퍼 초기 자본 (최초 실행 시 1회) ----------------
PAPER_INITIAL_KRW=10000000
PAPER_INITIAL_USDT=5000

# ---------------- 저장소 / 로그 ----------------
DB_PATH=data/kimp.db
LOG_LEVEL=INFO
LOG_DIR=logs
